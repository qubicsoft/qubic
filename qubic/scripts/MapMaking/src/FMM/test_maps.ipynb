    "def chi2_fwhm(fwhm):\n",
    "    if fwhm < 0 or fwhm > 0.1:\n",
    "        return np.inf\n",
    "    else:\n",
    "        C = HealpixConvolutionGaussianOperator(fwhm)\n",
    "        input_maps = C(test_in)\n",
    "            \n",
    "        return np.sum((test_out - input_maps)[seenpix] ** 2) / np.sum(test_out[seenpix] ** 2)"
   ]
  },
