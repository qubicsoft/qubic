    "plt.figure(figsize=(20, 10))\n",
    "plt.plot(fwhm, list_chi2, label=\"Chi2 function\")\n",
    "plt.vlines(fwhm_best, np.min(list_chi2), np.max(list_chi2), color=\"red\", linestyle=\"--\",\n",
