    "\n",
    "fwhm = np.logspace(np.log10(0.002), np.log10(0.01), num=200)\n",
    "for i in fwhm:\n",
    "    list_chi2.append(chi2_fwhm(i))\n",
    "\n",
    "list_chi2 = np.array(list_chi2)"
